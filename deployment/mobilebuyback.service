[Unit]
Description=Gunicorn daemon for Mobile Buyback DRF Backend
After=network.target mariadb.service

[Service]
User=user
Group=user
WorkingDirectory=/data/home/mobilebuyback_backend
EnvironmentFile=/data/home/mobilebuyback_backend/.env
ExecStart=/data/home/mobilebuyback_backend/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8010 \
    --timeout 120 \
    --access-logfile /data/home/mobilebuyback_logs/access.log \
    --error-logfile /data/home/mobilebuyback_logs/error.log \
    config.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
