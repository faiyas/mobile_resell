[Unit]
Description=Gunicorn daemon for Mobile Buyback DRF Backend
After=network.target mariadb.service

[Service]
User=user
Group=user
WorkingDirectory=/data/home/mobile_resell/backend
ExecStart=/data/home/pondytourstravels/backend/venv/bin/gunicorn \
    --workers 4 \
    --threads 8 \
    --worker-class gthread \
    --max-requests 2000 \
    --max-requests-jitter 100 \
    --timeout 60 \
    --bind 127.0.0.1:8010 \
    --access-logfile /data/home/mobile_resell/backend/logs/gunicorn_access.log \
    --error-logfile /data/home/mobile_resell/backend/logs/gunicorn_error.log \
    --capture-output \
    config.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
